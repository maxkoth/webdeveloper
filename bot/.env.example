# Copy to .env and fill in. NEVER commit .env.

# Which data provider: "alpaca" (recommended — free tier + $99 real-time, also a
# broker for paper/live trading) or "polygon".
DATA_PROVIDER=alpaca

# --- Alpaca (https://alpaca.markets) ---
# Free tier works for building/backtesting/paper-testing (feed=iex, real-time
# IEX subset). Upgrade to "Algo Trader Plus" ($99/mo) and set feed=sip for full
# real-time market coverage before going live.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex          # iex (free) | sip (paid real-time, full market)

# --- Polygon (alternative; https://polygon.io) ---
POLYGON_API_KEY=
POLYGON_REALTIME=false

# --- Twilio SMS (https://twilio.com) — only needed when MODE=live ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=             # your Twilio number, E.164 e.g. +18885551234
ALERT_TO=+16464621236    # where alerts go

# --- Value BUY alerts (npm run value) ---
# The website must be running (npm run dev) so the screener API is reachable.
VALUE_SCREEN_URL=http://localhost:3000/api/screen
# Your wish-list: get a text the moment one of these hits its buy-below price.
# Leave blank to instead discover bargains across the whole screened universe.
VALUE_WATCHLIST=AAPL,COST,V,MA,GOOGL

# --- Behavior ---
MODE=dry-run             # dry-run = print alerts (tune here) | live = send texts
SCAN_INTERVAL_MIN=2
