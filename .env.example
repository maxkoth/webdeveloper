# Daily setup scanner — environment variables.
# Copy to .env.local (Next.js loads it automatically) or set these as
# secrets in your deploy / GitHub Actions. Everything here is OPTIONAL: with
# nothing set, the scanner runs on live TradingView + Yahoo data and the
# catalyst dimension uses its gap+volume proxy. Add keys to unlock more.

# --- News sentiment (Finnhub) ------------------------------------------------
# Free key at https://finnhub.io. Enables real headline sentiment in the
# catalyst dimension instead of the gap+volume proxy.
FINNHUB_API_KEY=

# --- SMS alerts (Twilio) -----------------------------------------------------
# From your Twilio console. ALERT_TO is YOUR phone in E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
ALERT_TO=+16464621236

# Score at/above which an intraday threshold alert fires (default 80).
ALERT_SCORE=80
# When "1", threshold runs skip outside US market hours.
MARKET_HOURS_ONLY=1
# Optional path for dedupe state so the same intraday alert isn't sent twice.
STATE_FILE=

# --- Protect the /api/alerts route -------------------------------------------
# Required to call POST/GET /api/alerts. Pass as ?secret= or Bearer token.
ALERT_SECRET=

# --- Autopilot (auto-trading) ------------------------------------------------
# Broker: "dryrun" (default, places nothing) or "ibkr".
BROKER=dryrun
# Dry-run starting equity for simulation.
DRYRUN_EQUITY=100000

# Interactive Brokers: requires IB Gateway or TWS running locally with the API
# enabled. Paper port 7497 (default), live port 7496.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=101
# Connecting to a LIVE port is refused unless this is exactly "1".
IBKR_ALLOW_LIVE=

# Risk rails — SET YOUR OWN. Fractions of account equity (0.05 = 5%).
MAX_POSITION_PCT=0.05         # max in any one position
MAX_TOTAL_DEPLOYED_PCT=0.25   # max deployed across all autopilot positions
RISK_PER_TRADE_PCT=0.01       # risked per trade on the entry->stop distance
DAILY_LOSS_HALT_PCT=0.03      # halt new entries if account drops this much today
MAX_OPEN_POSITIONS=10
AUTOPILOT_MIN_SCORE=70        # only trade setups scoring at/above this
# Persist day-start equity (kill-switch baseline) across runs.
DAYMARK_FILE=

# Pilot copy-trade (optional, second strategy). JSON feed of {symbol,weight}[].
PILOT_NAME=
PILOT_FEED_URL=
