# Daily setup scanner — environment variables.
# Copy to .env.local (Next.js loads it automatically) or set these as
# secrets in your deploy / GitHub Actions. Everything here is OPTIONAL: with
# nothing set, the scanner runs on live TradingView + Yahoo data and the
# catalyst dimension uses its gap+volume proxy. Add keys to unlock more.

# --- News sentiment (Finnhub) ------------------------------------------------
# Free key at https://finnhub.io. Enables real headline sentiment in the
# catalyst dimension instead of the gap+volume proxy.
FINNHUB_API_KEY=

# --- SMS alerts (Twilio) -----------------------------------------------------
# From your Twilio console. ALERT_TO is YOUR phone in E.164 format.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
ALERT_TO=+16464621236

# Score at/above which an intraday threshold alert fires (default 80).
ALERT_SCORE=80
# When "1", threshold runs skip outside US market hours.
MARKET_HOURS_ONLY=1
# Optional path for dedupe state so the same intraday alert isn't sent twice.
STATE_FILE=

# --- Protect the /api/alerts route -------------------------------------------
# Required to call POST/GET /api/alerts. Pass as ?secret= or Bearer token.
ALERT_SECRET=
