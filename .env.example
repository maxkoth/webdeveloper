# Copy to .env and fill in. NEVER commit .env (it's gitignored).
# Used by `npm run build:cache` (the value-screener fundamentals cache).

# SEC asks for a descriptive identifier "Name email"
EDGAR_USER_AGENT="Your Name you@email.com"

# Alpaca — bulk daily prices for the screener (FREE tier is fine for this).
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
ALPACA_FEED=iex

# How many companies to cache. Start modest; 0 = the entire market (slow first run).
CACHE_MAX=1500
